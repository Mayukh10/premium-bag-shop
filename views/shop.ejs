<%- include('./partials/header') %>

<% if(success.length>0) { %>
    <div class="absolute top-5 left-1/2 -translate-x-1/2 -translate-y-1/2 p-3 rounded-md bg-blue-500">
        <span class="inline-block mt-1 mb-1 text-white">
            <%= success %>
        </span>
    </div>
<% } %>

<div class="w-full h-screen flex items-start px-20 py-20">
    <div class="w-[25%] flex h-screen flex-col items-start">
        <div class="flex items-center gap-2">
            <h3>sort by</h3>
            <form action="/shop">
                <select class="border-[1px] px-2 py-1" name="sortby" id="">
                    <option value="popular">Popular</option>
                    <option value="newest">Newest</option>
                </select>
            </form>
        </div>
        <div class="flex flex-col mt-20">
            <a class="block w-fit mb-2" href="">New Collection</a>
            <a class="block w-fit mb-2" href="">All Products</a>
            <a class="block w-fit mb-2" href="">Discounted Products</a>
        </div>
        <div class="mt-32">
            <a class="block w-fit mb-2" href="">Filter by :</a>
            <a class="block w-fit mb-2" href="">Availability</a>
            <a class="block w-fit mb-2" href="">Discount</a>
        </div>
    </div>
    <div class="w-[75%] flex flex-col gap-5 h-screen">
        <% let counter = 0; %>
        <% products.forEach(function(product, index){ %>
            <% if (counter === 0) { %>
                <div class="flex items-start gap-5">
            <% } %>
            <div class="w-48"> <!-- Reduced width -->
                <div class="w-full h-40 flex items-center justify-center bg-[<%= product.bgcolor %>]"> <!-- Reduced height -->
                    <img class="h-[10rem]" src="data:image/jpeg;base64,<%= product.image.toString('base64') %>" alt=""> <!-- Reduced image height -->
                </div>
                <div class="flex justify-between bg-[<%= product.panelcolor %>] items-center px-4 py-2 text-[<%= product.textcolor %>]"> <!-- Reduced padding -->
                    <div>
                        <h3 class="text-sm"><%= product.name %></h3> <!-- Reduced font size -->
                        <h4 class="text-sm">₹ <%= product.price %></h4> <!-- Reduced font size -->
                    </div>
                    <a class="w-6 h-6 flex items-center justify-center rounded-full bg-white" href="/addtocart/<%= product._id %>"> <!-- Reduced size -->
                        <i class="ri-add-line"></i>
                    </a>
                </div>
            </div>
            <% counter++; %>
            <% if (counter === 4 || index === products.length - 1) { %>
                </div>
                <% counter = 0; %>
            <% } %>
        <% }); %>
    </div>
</div>
<%- include('./partials/footer') %>